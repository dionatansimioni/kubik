<?xml version="1.0" encoding="UTF-8"?>
<!-- Esquema de configuração do efeito: o KWin só entrega ao readConfig()
     as chaves declaradas aqui (grupo [Effect-kubikanimations] do kwinrc). -->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="kwinrc"/>
  <!-- Vazio: o KWin já posiciona o loader no grupo [Effect-kubikanimations];
       um nome aqui viraria um subgrupo e nada seria lido. -->
  <group name="">
    <entry name="Duration" type="Int">
      <label>Duração base da animação, em milissegundos</label>
      <default>250</default>
      <min>1</min>
      <max>2000</max>
    </entry>
    <entry name="Curve" type="String">
      <label>Curva de easing (nome do QEasingCurve: OutCubic, OutQuint, OutExpo, OutBack, Linear…)</label>
      <default>OutCubic</default>
    </entry>
  </group>
</kcfg>
