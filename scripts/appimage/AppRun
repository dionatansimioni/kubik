#!/usr/bin/env bash
# Instalador do Kubik em AppImage: dois cliques instalam ou atualizam o script,
# o efeito de animação, o ícone da bandeja, o ícone do app e a entrada "Kubik"
# no menu (o mesmo install.sh do .tar.gz, que vem aqui dentro).
#
# Uso: Kubik-<versão>-x86_64.AppImage                (o gerenciador; sem ele, kdialog)
#      Kubik-<versão>-x86_64.AppImage --install [--yes]   (terminal)
#      Kubik-<versão>-x86_64.AppImage --uninstall [--yes]
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
BUNDLE=$(find "$HERE" -maxdepth 1 -type d -name 'kubik-*' | head -n1)
APP_ID=io.github.dionatansimioni.kubik
DATA=${XDG_DATA_HOME:-$HOME/.local/share}

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in pt*) PT=1 ;; *) PT="" ;; esac
# t "<inglês>" "<português>"
t() { if [ -n "$PT" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

meta_version() { sed -n 's/.*"Version": *"\([^"]*\)".*/\1/p' "$1/metadata.json" 2>/dev/null | head -n1; }
NEW=$(meta_version "$BUNDLE/packages/kubik")
installed_version() {
    local p
    p=$(kpackagetool6 --type=KWin/Script --show kubik 2>/dev/null | sed -n 's/^ *Path *: *//p')
    [ -n "$p" ] && meta_version "${p%/}"
}
loaded() {  # loaded /Scripting org.kde.kwin.Scripting.isScriptLoaded kubik
    dbus-send --session --print-reply --dest=org.kde.KWin "$1" "$2" "string:$3" 2>/dev/null | grep -q 'boolean true'
}
newer() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ] && [ "$1" != "$2" ]; }

LOG=$(mktemp "${TMPDIR:-/tmp}/kubik-install.XXXXXX")
trap 'rm -f "$LOG"' EXIT
do_install() { "$BUNDLE/install.sh" >"$LOG" 2>&1; local r=$?; cat "$LOG"; return $r; }
do_uninstall() {
    if [ -x "$DATA/kubik/uninstall.sh" ]; then bash "$DATA/kubik/uninstall.sh"; else "$BUNDLE/uninstall.sh"; fi
}

# Resumo depois de instalar, no idioma do sistema.
summary() {
    if ! loaded /Scripting org.kde.kwin.Scripting.isScriptLoaded kubik; then
        t "Kubik $NEW is installed. Turn it on in System Settings › Window Management › KWin Scripts." \
          "O Kubik $NEW foi instalado. Ative em Configurações do Sistema › Gerenciamento de janelas › Scripts do KWin."
    elif ! loaded /Effects org.kde.kwin.Effects.isEffectLoaded kubikanimations; then
        t "Kubik $NEW is installed and tiling your windows. Log out and back in once to turn on the animations." \
          "O Kubik $NEW foi instalado e já está organizando as janelas. Saia e entre na sessão uma vez para ligar as animações."
    else
        t "Kubik $NEW is installed and active." "O Kubik $NEW foi instalado e está ativo."
    fi
}

MANAGER_ID=$APP_ID.manager
MANAGER_DIR=$DATA/plasma/plasmoids/$MANAGER_ID
# O gerenciador é um plasmoide oculto aberto pelo plasmawindowed (vem em todo
# Plasma, no plasma-workspace). Não o `qml`: no Fedora ele só vem com o
# qt6-qtdeclarative-devel.
open_manager() {
    [ -f "$MANAGER_DIR/metadata.json" ] && [ -x "$DATA/kubik/open.sh" ] || return 1
    (setsid "$DATA/kubik/open.sh" >/dev/null 2>&1 </dev/null &)
}

YES=""
for a in "$@"; do [ "$a" = --yes ] && YES=1; done

case "${1:-}" in
    --help|-h)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
    --install)
        if [ -z "$YES" ]; then
            read -r -p "$(t "Install Kubik $NEW? [y/N] " "Instalar o Kubik $NEW? [s/N] ")" ans
            case "$ans" in [sSyY]*) ;; *) exit 1 ;; esac
        fi
        do_install || exit $?
        echo "=== $(summary)"
        exit 0 ;;
    --uninstall)
        if [ -z "$YES" ]; then
            read -r -p "$(t "Remove Kubik? [y/N] " "Remover o Kubik? [s/N] ")" ans
            case "$ans" in [sSyY]*) ;; *) exit 1 ;; esac
        fi
        do_uninstall; exit $? ;;
esac

# ---- gerenciador (janela própria) ---------------------------------------------
# A mesma janela da entrada "Kubik" do menu, oferecendo instalar a versão que
# vem aqui dentro. O plasmawindowed é instância única (um segundo processo só
# repassa o nome do plasmoide, sem argumentos nem ambiente) e o AppImage
# desmonta ao sair: o pacote vai para um lugar fixo da sessão (STAGE_DIR em
# src/manager/logic.ts) e o plasmoide para a pasta de plasmoides, de onde
# qualquer plasmawindowed o acha. Sem plasmawindowed: kdialog.
# KUBIK_KDIALOG=1 força o plano B (os testes do kdialog).
STAGE=${XDG_RUNTIME_DIR:-/tmp}/kubik-appimage-$(id -u)
if [ -z "${KUBIK_KDIALOG:-}" ] && command -v plasmawindowed >/dev/null; then
    rm -rf "$STAGE" && mkdir -p "$STAGE" && cp -R "$BUNDLE/." "$STAGE/" || exit 1
    # Só troca o gerenciador instalado se o deste AppImage não for mais velho.
    if [ ! -f "$MANAGER_DIR/metadata.json" ] || ! newer "$(meta_version "$MANAGER_DIR")" "$NEW"; then
        rm -rf "$MANAGER_DIR" && mkdir -p "$MANAGER_DIR" && cp -R "$BUNDLE/manager/." "$MANAGER_DIR/" || exit 1
    fi
    "$BUNDLE/open.sh" "$MANAGER_ID"
    exit 0
fi

# ---- plano B: janelas do kdialog -------------------------------------------------

if ! command -v kdialog >/dev/null; then
    # Sem kdialog: o mesmo, num terminal.
    if [ -t 0 ]; then exec "$0" --install; fi
    for term in konsole xterm; do
        command -v "$term" >/dev/null && exec "$term" -e "${APPIMAGE:-$0}" --install
    done
    echo "$(t "Run this from a terminal:" "Rode num terminal:") ${APPIMAGE:-$0} --install" >&2
    exit 1
fi

OLD=$(installed_version)
TITLE=$(t "Kubik installer" "Instalador do Kubik")
if [ -z "$OLD" ]; then
    kdialog --title "$TITLE" --icon "$HERE/$APP_ID.svg" --yes-label "$(t Install Instalar)" --no-label "$(t Cancel Cancelar)" \
        --yesno "$(t "Install Kubik $NEW?

Pop!_Shell-style auto-tiling for KDE Plasma: the KWin script, the animations, the tray icon and a \"Kubik\" entry in the menu. Meta+arrows move the focus between windows (KDE's quick tile on those keys is turned off until you uninstall)." \
"Instalar o Kubik $NEW?

Auto-tiling no estilo Pop!_Shell para o KDE Plasma: o script do KWin, as animações, o ícone na bandeja e uma entrada \"Kubik\" no menu. Meta+setas passam o foco entre as janelas (o quick tile do KDE nessas teclas fica desligado até desinstalar).")" || exit 0
elif newer "$NEW" "$OLD"; then
    kdialog --title "$TITLE" --yes-label "$(t Update Atualizar)" --no-label "$(t Cancel Cancelar)" \
        --yesno "$(t "Update Kubik from $OLD to $NEW?" "Atualizar o Kubik de $OLD para $NEW?")" || exit 0
else
    kdialog --title "$TITLE" --yes-label "$(t "Open Kubik" "Abrir o Kubik")" --no-label "$(t Reinstall Reinstalar)" \
        --cancel-label "$(t Close Fechar)" \
        --yesnocancel "$(t "Kubik $OLD is already installed." "O Kubik $OLD já está instalado.")"
    case $? in
        0) open_manager; exit 0 ;;
        1) ;;
        *) exit 0 ;;
    esac
fi

if ! do_install >/dev/null; then
    kdialog --title "$TITLE" --error "$(t "Installation failed:" "A instalação falhou:")

$(tail -n 15 "$LOG")"
    exit 1
fi
kdialog --title "$TITLE" --yes-label "$(t "Open Kubik" "Abrir o Kubik")" --no-label "$(t Close Fechar)" \
    --yesno "$(summary)" && open_manager
exit 0
