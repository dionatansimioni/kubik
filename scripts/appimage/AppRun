#!/usr/bin/env bash
# Kubik em AppImage: abre o gerenciador (usr/bin/kubik-manager, um app Qt com
# o próprio Qt dentro), que instala, atualiza, repara ou remove o Kubik (o
# mesmo install.sh do .tar.gz, que vem aqui dentro) e abre as configurações.
#
# Uso: Kubik-<versão>-x86_64.AppImage                (o gerenciador; sem ele, menu do kdialog)
#      Kubik-<versão>-x86_64.AppImage --install [--yes]   (terminal)
#      Kubik-<versão>-x86_64.AppImage --uninstall [--yes]
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
BUNDLE=$(find "$HERE" -maxdepth 1 -type d -name 'kubik-*' | head -n1)
APP_ID=io.github.dionatansimioni.kubik
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
# O install.sh guarda o AppImage em ~/.local/share/kubik (a entrada do menu o abre).
export KUBIK_APPIMAGE=${APPIMAGE:-}

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in pt*) PT=1 ;; *) PT="" ;; esac
# t "<inglês>" "<português>"
t() { if [ -n "$PT" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

meta_version() { sed -n 's/.*"Version": *"\([^"]*\)".*/\1/p' "$1/metadata.json" 2>/dev/null | head -n1; }
NEW=$(meta_version "$BUNDLE/packages/kubik")
installed_version() {
    local p
    # LC_ALL=C: em pt-BR o kpackagetool6 escreve "Caminho" no lugar de "Path".
    p=$(LC_ALL=C LANGUAGE= kpackagetool6 --type=KWin/Script --show kubik 2>/dev/null | sed -n 's/^ *Path *: *//p')
    [ -n "$p" ] && meta_version "${p%/}"
}
loaded() {  # loaded /Scripting org.kde.kwin.Scripting.isScriptLoaded kubik
    dbus-send --session --print-reply --dest=org.kde.KWin "$1" "$2" "string:$3" 2>/dev/null | grep -q 'boolean true'
}
newer() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ] && [ "$1" != "$2" ]; }

LOG=$(mktemp "${TMPDIR:-/tmp}/kubik-install.XXXXXX")
trap 'rm -f "$LOG"' EXIT
do_install() { "$BUNDLE/install.sh" >"$LOG" 2>&1; local r=$?; cat "$LOG"; return $r; }
do_uninstall() {
    if [ -x "$DATA/kubik/uninstall.sh" ]; then bash "$DATA/kubik/uninstall.sh"; else "$BUNDLE/uninstall.sh"; fi
}

# Resumo depois de instalar, no idioma do sistema.
summary() {
    if ! loaded /Scripting org.kde.kwin.Scripting.isScriptLoaded kubik; then
        t "Kubik $NEW is installed. Turn it on in System Settings › Window Management › KWin Scripts." \
          "O Kubik $NEW foi instalado. Ative em Configurações do Sistema › Gerenciamento de janelas › Scripts do KWin."
    elif ! loaded /Effects org.kde.kwin.Effects.isEffectLoaded kubikanimations; then
        t "Kubik $NEW is installed and tiling your windows. Log out and back in once to turn on the animations." \
          "O Kubik $NEW foi instalado e já está organizando as janelas. Saia e entre na sessão uma vez para ligar as animações."
    else
        t "Kubik $NEW is installed and active." "O Kubik $NEW foi instalado e está ativo."
    fi
}

YES=""
for a in "$@"; do [ "$a" = --yes ] && YES=1; done

case "${1:-}" in
    --help|-h)
        sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
    --install)
        if [ -z "$YES" ]; then
            read -r -p "$(t "Install Kubik $NEW? [y/N] " "Instalar o Kubik $NEW? [s/N] ")" ans
            case "$ans" in [sSyY]*) ;; *) exit 1 ;; esac
        fi
        do_install || exit $?
        echo "=== $(summary)"
        exit 0 ;;
    --uninstall)
        if [ -z "$YES" ]; then
            read -r -p "$(t "Remove Kubik? [y/N] " "Remover o Kubik? [s/N] ")" ans
            case "$ans" in [sSyY]*) ;; *) exit 1 ;; esac
        fi
        do_uninstall; exit $? ;;
esac

# ---- gerenciador ------------------------------------------------------------------
# O app sai com 0 quando o usuário fecha a janela. Qualquer outra saída (3: a
# janela não abriu; 127: faltou biblioteca; sinal: travou) cai no menu do
# kdialog. O motivo fica em ~/.cache/kubik/appimage.log.
# KUBIK_KDIALOG=1 força o menu (os testes dele).
RUNLOG=${XDG_CACHE_HOME:-$HOME/.cache}/kubik/appimage.log
mkdir -p "$(dirname "$RUNLOG")" 2>/dev/null
[ -f "$RUNLOG" ] && tail -n 300 "$RUNLOG" > "$RUNLOG.tmp" 2>/dev/null && mv -f "$RUNLOG.tmp" "$RUNLOG"
note() { echo "$(date '+%F %T') $*" >> "$RUNLOG" 2>/dev/null; }

if [ -z "${KUBIK_KDIALOG:-}" ]; then
    note "Kubik $NEW: abrindo o gerenciador (${XDG_SESSION_TYPE:-?}, ${XDG_CURRENT_DESKTOP:-?})"
    "$HERE/usr/bin/kubik-manager" --bundle "$BUNDLE" 2> >(tee -a "$RUNLOG" >&2)
    r=$?
    [ $r -eq 0 ] && exit 0
    note "o gerenciador saiu com $r: menu do kdialog"
else
    note "Kubik $NEW: KUBIK_KDIALOG, menu do kdialog"
fi

# ---- reserva: menu do kdialog ---------------------------------------------------------
# As mesmas ações do gerenciador, sem nada além do kdialog.

if ! command -v kdialog >/dev/null; then
    note "sem kdialog: terminal"
    if [ -t 0 ]; then exec "$0" --install; fi
    for term in konsole xterm; do
        command -v "$term" >/dev/null && exec "$term" -e "${APPIMAGE:-$0}" --install
    done
    echo "$(t "Run this from a terminal:" "Rode num terminal:") ${APPIMAGE:-$0} --install" >&2
    exit 1
fi

TITLE="Kubik"
while :; do
    OLD=$(installed_version)
    items=()
    if [ -z "$OLD" ]; then
        text=$(t "Kubik is not installed.

Pop!_Shell-style auto-tiling for KDE Plasma: the KWin script, the animations, the tray icon and a \"Kubik\" entry in the menu. Meta+arrows move the focus between windows (KDE's quick tile on those keys is turned off until you remove Kubik)." \
"O Kubik não está instalado.

Auto-tiling no estilo Pop!_Shell para o KDE Plasma: o script do KWin, as animações, o ícone na bandeja e uma entrada \"Kubik\" no menu. Meta+setas passam o foco entre as janelas (o quick tile do KDE nessas teclas fica desligado até remover o Kubik).")
        items+=(install "$(t "Install Kubik $NEW" "Instalar o Kubik $NEW")")
    else
        text=$(t "Kubik $OLD is installed." "O Kubik $OLD está instalado.")
        newer "$NEW" "$OLD" && items+=(update "$(t "Update to $NEW" "Atualizar para $NEW")")
        items+=(settings "$(t "Settings" "Configurações")")
        items+=(repair "$(t "Reinstall $NEW" "Reinstalar o $NEW")")
        items+=(remove "$(t "Remove Kubik" "Remover o Kubik")")
    fi
    choice=$(kdialog --title "$TITLE" --menu "$text" "${items[@]}") || exit 0
    note "menu: $choice"
    case "$choice" in
        install|update|repair)
            if ! do_install >/dev/null; then
                kdialog --title "$TITLE" --error "$(t "Installation failed:" "A instalação falhou:")

$(tail -n 15 "$LOG")"
                continue
            fi
            kdialog --title "$TITLE" --msgbox "$(summary)" ;;
        settings)
            (setsid plasmawindowed "$APP_ID" >/dev/null 2>&1 </dev/null &)
            exit 0 ;;
        remove)
            kdialog --title "$TITLE" --yes-label "$(t Remove Remover)" --no-label "$(t Cancel Cancelar)" \
                --warningyesno "$(t "Remove Kubik, its tray icon and its shortcuts?" "Remover o Kubik, o ícone da bandeja e os atalhos?")" || continue
            do_uninstall >/dev/null 2>&1
            kdialog --title "$TITLE" --msgbox "$(t "Kubik was removed." "O Kubik foi removido.")" ;;
        *) exit 0 ;;
    esac
done
